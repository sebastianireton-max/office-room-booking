# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored by default (see .gitignore) — never commit real keys.
# Design package Section 10.1: secrets live in environment variables only.

# --- Stripe -------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys (use TEST keys until you're ready to go live)
# NOTE: fill in your own real key here. Do not use a string shaped like a
# real Stripe key (sk_test_/pk_test_/whsec_ followed by a plausible-length
# token) even as a placeholder — GitHub's push-protection secret scanner
# flags those on pattern/length alone, even repeated-character filler.
STRIPE_SECRET_KEY=replace-with-your-own-sk_test-key-from-the-stripe-dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-own-pk_test-key-from-the-stripe-dashboard

# From the Stripe Dashboard once you create a webhook endpoint pointing at
# https://your-domain.com/api/webhooks/stripe (or via `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=replace-with-your-own-whsec-signing-secret-from-the-stripe-dashboard

# --- App ------------------------------------------------------------------
# Absolute origin, no trailing slash. Feeds canonical URLs, the sitemap, emails
# and the Google sign-in redirect, so set it to the real https domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Studio time zone lives in src/lib/site-config.ts (SITE.timeZone), not here.

# --- Sign in with Google ----------------------------------------------------
# Left blank on purpose: blank means "off", and the site still takes bookings.
# 1. https://console.cloud.google.com/apis/credentials -> Create credentials ->
#    OAuth client ID -> Web application.
# 2. Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
#    (add http://localhost:3000/api/auth/google/callback for local testing).
# 3. OAuth consent screen: scopes openid, email, profile only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out.
AUTH_SECRET=

# --- Admin -----------------------------------------------------------------
# Comma-separated Google account emails allowed into /admin. Checked on every
# request, so removing an address revokes access immediately.
ADMIN_EMAILS=

# --- Confirmation email (Resend) ------------------------------------------------
# https://resend.com -> verify your domain -> create an API key.
# EMAIL_FROM must be on that verified domain, e.g. Clockroom <bookings@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# --- Google Search Console -----------------------------------------------------
# Search Console -> add property -> HTML tag method. Paste only the content="..."
# value. Then submit <NEXT_PUBLIC_SITE_URL>/sitemap.xml.
GOOGLE_SITE_VERIFICATION=

# --- Testing ---------------------------------------------------------------------
# Point at a throwaway file so tests never touch data/bookings.db.
# DATABASE_PATH=./data/test.db
