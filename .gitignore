# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template: no secrets, and PROJECT_CONTEXT.md/README point
# newcomers at it ("copy .env.example to .env.local") — it must stay tracked.
!.env.example

# vercel
.vercel

# local sqlite data — may contain real customer names/emails once in use.
# Design package Section 10.7: PII minimized, never committed.
/data/*.db
/data/*.db-*

# typescript
*.tsbuildinfo
next-env.d.ts

# design-verified output: screenshots + report, regenerated on every run
/.design-audit/

# agent worktrees and Playwright MCP session logs
/.claude/worktrees/
/.playwright-mcp/
